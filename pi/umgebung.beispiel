# Zugangsdaten für den Dienst eu-piraten – liegt als /etc/eu-piraten.env (nur root lesbar).
# Nach Änderungen: sudo systemctl restart eu-piraten

# Postiz: Adresse der Instanz, z. B. https://postiz.example.org (API unter /api/public/v1) und API-Key aus Postiz → Einstellungen → Public API
POSTIZ_URL=
POSTIZ_API_KEY=
# Nur auf diesen Kanälen posten (Name, Profil oder ID, kommagetrennt) – Übersicht im Bot mit /kanaele.
# Alternativ oder zusätzlich alle Kanäle eines Postiz-„Kunden“. Ohne Auswahl wird nichts gepostet.
POSTIZ_KANAELE=
POSTIZ_KUNDE=

# Telegram-Bot von @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=
# Leer lassen, Dienst starten, dem Bot schreiben – er antwortet mit der Chat-ID. Dann hier eintragen.
TELEGRAM_CHAT_ID=

# Chromium aus apt (trägt pi/install.sh ein)
CHROMIUM_PATH=/usr/bin/chromium
